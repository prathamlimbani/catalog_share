# ============================================================================
#  CatalogShare - release signing configuration TEMPLATE
# ============================================================================
#  Copy this file to  android/keystore.properties  and fill in the real values.
#
#      copy android\keystore.properties.example android\keystore.properties
#
#  android/keystore.properties is gitignored and MUST NEVER be committed.
#  If it is absent, `gradlew.bat assembleDebug` still works and
#  `gradlew.bat bundleRelease` produces an UNSIGNED bundle that Play will reject.
#
#  See RELEASE.md for the keytool command that generates the keystore.
# ============================================================================

# Path to the upload keystore. An absolute path is resolved as-is; a relative
# path is resolved AGAINST THE android/ DIRECTORY (Gradle's rootProject).
# Keep the keystore OUTSIDE the repository - nothing in .gitignore can protect a
# file someone force-adds, so the only real safeguard is it not being in the tree.
# On Windows use forward slashes here; Gradle normalises them.
storeFile=C:/catalogshare-keys/catalogshare-upload.jks

# Password protecting the keystore file itself.
storePassword=CHANGE_ME_KEYSTORE_PASSWORD

# The alias of the key inside the keystore (-alias passed to keytool).
keyAlias=catalogshare-upload

# Password protecting that specific key. keytool lets this match storePassword;
# the Gradle signing config still requires it to be stated explicitly.
keyPassword=CHANGE_ME_KEY_PASSWORD
