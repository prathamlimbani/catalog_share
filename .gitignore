# Environment variables
.env
.env.*
# ...but .env.app holds build configuration, not secrets, and the
# Android build will not produce the right bundle without it.
!.env.app

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Android release signing - NEVER commit these
android/keystore.properties
*.jks
*.keystore

# Exported chat transcripts dropped in the repo root by /export
[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt

# Icon/splash source images are generated by scripts/make-app-assets.mjs
# from public/logo.png — kept out of the tree so they cannot drift from it.
/assets/

# Signed release artifacts. Large binaries, and rebuildable from a tagged commit.
release-output/
*.aab
*.apk

# Database exports. These carry merchant and customer personal data - business
# emails, phone numbers, addresses, GST numbers - and must not enter git history,
# where deleting them later does not actually remove them.
full-database-backup-*.json
Master_Data_Export_*.xlsx

# Supabase export: real merchant PII, plus the temporary passwords issued during
# the migration. Never commit - git history does not forget, and this is exactly
# the data a leaked repo would be judged on.
supabase-export/
